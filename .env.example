# ==============================================================================
# SinTech Workspace Environment Configuration
# ==============================================================================

# Server & Client Ports
PORT=3000
BASE_PATH=/

# Production Origin (Used for sitemap.xml, canonical URLs, and OpenGraph images)
# e.g., https://sintech.dev
VITE_SITE_URL=

# Allowed CORS Origin for API Server (Production)
SITE_ORIGIN=http://localhost:5173

# Replit Specific Allowed Domains (Comma-separated)
REPLIT_DOMAINS=

# Database Connection (PostgreSQL)
# e.g., postgresql://username:password@localhost:5432/sintech
DATABASE_URL=postgresql://localhost:5432/sintech

# Admin Access Token (Bearer token for GET /api/admin/contacts)
# Generate a secure 32+ character random string
ADMIN_TOKEN=

# Resend Email Notification (Optional: lead notification on contact form submissions)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SinTech <onboarding@resend.dev>
CONTACT_TO_EMAIL=sintech11395@gmail.com

# Analytics Configuration (Optional: Plausible or Umami)
VITE_ANALYTICS_URL=
VITE_ANALYTICS_SITE_ID=
